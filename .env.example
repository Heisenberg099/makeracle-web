# Public URL of the site (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=https://makeracle.in

# Protects GET /api/leads and the /admin/leads inbox. Required in production.
ADMIN_TOKEN=change-me

# Optional: every new lead is POSTed here as JSON (CRM, Zapier/Make hook, Google Apps Script…)
CRM_WEBHOOK_URL=
